# Plantilla de variables de entorno — los valores de acá son de ejemplo,
# no reales, solo para mostrar el formato esperado de cada una. Seguro de
# commitear (a diferencia de .env.local, que está en .gitignore, y sí trae
# los valores reales). Copiar a .env.local y reemplazar cada valor de
# ejemplo por el real para desarrollar localmente; en Vercel, cada una se
# configura en Project Settings → Environment Variables (docs/PLAN.md §
# Fase 9: "nada de secretos en el repo").

# lib/whatsapp/url.ts, CarritoView.tsx — número de WhatsApp del negocio,
# solo dígitos con código de país.
NEXT_PUBLIC_WHATSAPP_NUMBER=50212345678

# app/api/quote-log/route.ts, lib/quoteLog/ — registro de cotizaciones
# (docs/PLAN.md § 6.4). QUOTE_LOG_URL es el endpoint del Google Apps
# Script/Airtable que recibe el POST; QUOTE_LOG_TOKEN es el secreto que
# ese endpoint espera para aceptar la petición — generarlo random, no
# reusar este valor de ejemplo.
QUOTE_LOG_URL=https://script.google.com/macros/s/EJEMPLO_REEMPLAZAR_CON_EL_ID_REAL/exec
QUOTE_LOG_TOKEN=reemplazar-con-un-token-aleatorio-largo-y-secreto

# lib/seo/site.ts — base para metadataBase/JSON-LD/sitemap/robots.
# OBLIGATORIA en Production (el build falla sin ella); en Preview de
# Vercel cae a VERCEL_URL si no se define. En local, sin definir cae a
# http://localhost:3000.
SITE_URL=https://sonoro.gt

# lib/seo/business.ts, components/layout/SiteFooter.tsx,
# app/nosotros/page.tsx — JSON-LD LocalBusiness y los datos de contacto
# visibles en el sitio. Todos opcionales: cada campo que falte
# simplemente no se muestra/emite, nunca se inventa (CLAUDE.md §
# Decisiones abiertas: dirección/teléfono/correo sin confirmar) — los
# valores de acá son solo un ejemplo de formato, no los reales de Sonoro.
BUSINESS_ADDRESS_STREET=5a Avenida 10-20, Zona 10
BUSINESS_ADDRESS_LOCALITY=Ciudad de Guatemala
BUSINESS_ADDRESS_REGION=Guatemala
BUSINESS_ADDRESS_POSTAL_CODE=01010
BUSINESS_ADDRESS_COUNTRY=GT
BUSINESS_PHONE=+502 1234 5678
BUSINESS_EMAIL=ventas@sonoro.gt
BUSINESS_OPENING_HOURS=Mo-Fr 09:00-18:00,Sa 09:00-13:00

# components/analytics/GoogleAnalytics.tsx — docs/PLAN.md § Fase 9. Sin
# definir, no se inyecta ningún script de GA. Formato G-XXXXXXXXXX, de la
# propiedad GA4 (ver respuesta sobre qué propiedad crear).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
