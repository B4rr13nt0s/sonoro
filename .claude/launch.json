{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sonoro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "sonoro-dev-chat",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "3001"
      ],
      "port": 3001,
      "env": {
        "NEXT_PUBLIC_CHAT_ENABLED": "true"
      }
    }
  ]
}