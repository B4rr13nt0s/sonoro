# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
.lighthouseci/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sonoro — salida del importador, nunca versionada
reports/

# sonoro — archivo de bloqueo que Excel crea junto a catalogo.xlsx mientras
# está abierto. No es parte del libro.
~$*

# sonoro — caché de Python de los scripts de Blender
__pycache__/
*.pyc

# sonoro — los .glb los escribe Blender en public/models/, que es la copia
# que sirve el sitio. Los que quedan junto a los scripts son sobras de
# corridas viejas y duplicarían binarios en el historial.
scripts/models3d*/*.glb

# sonoro — pipeline v1 de modelos 3D, superada por scripts/models3d_v2/.
# Se conserva en disco como referencia local, pero no se versiona: los
# scripts vigentes son los de _v2 y tener los dos en el repo invita a
# regenerar un modelo con el pipeline equivocado.
scripts/models3d/

# sonoro — transcripciones de sesión de Claude Code. Se generan en la raíz
# del proyecto, no son parte del sitio y pesan cientos de KB cada una.
2[0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-[0-9]*.txt
